{
  "name": "imagelibrary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:static",
    "build:static": "tsx --env-file=.env scripts/export-images-json.ts && next build",
    "deploy:pages": "wrangler pages deploy out --project-name=prompt",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "api:dev": "wrangler dev --config workers/mini-api/wrangler.toml",
    "api:deploy": "wrangler deploy --config workers/mini-api/wrangler.toml"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@vidstack/react": "^1.15.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compressorjs": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vidstack": "^1.15.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.122.0"
  }
}
